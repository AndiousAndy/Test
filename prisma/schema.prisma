// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  credits       Int       @default(1000)
  balance       Decimal   @default(1000.00) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isAdmin       Boolean   @default(false)
  coins         Int       @default(0)
  matchesAsP1   Match[]   @relation("Player1Matches")
  matchesAsP2   Match[]   @relation("Player2Matches")
  wonMatches    Match[]   @relation("WinnerMatches")
  messages      Message[]
  transactions  Transaction[]
}

model Match {
  id              String    @id @default(cuid())
  entryFee        Decimal   @db.Decimal(10, 2)
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, DISPUTED, CANCELLED_BY_HOST
  scheduledFor    DateTime
  roundDurationMinutes Int     @default(3) // Default to 3 minutes
  numberOfRounds       Int     @default(5) // Default to 5 rounds
  isPrivate         Boolean   @default(false) // Indicates if the match is private (URL only)
  region           String?  // Optional region specifier (e.g., NA, EU, ASIA)
  isPractice       Boolean  @default(false) // True if no entry fee is actually charged
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  player1         User      @relation("Player1Matches", fields: [player1Id], references: [id])
  player1Id       String
  player2         User?     @relation("Player2Matches", fields: [player2Id], references: [id])
  player2Id       String?
  winner          User?     @relation("WinnerMatches", fields: [winnerId], references: [id])
  winnerId        String?
  player1Outcome  String?   // WIN, LOSS, null
  player2Outcome  String?   // WIN, LOSS, null
  messages        Message[]
  lobbyNumber     String?
  transactions    Transaction[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
  type      String   @default("USER") // USER, SYSTEM
  isSystem  Boolean  @default(false) // For system messages like "Player joined", "Lobby number set", etc.
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  MATCH_ENTRY
  MATCH_WINNING
  REFUND
  REFUND_MATCH_ENTRY
  ADJUSTMENT // Manual admin adjustment
  MATCH_ADMIN_CANCEL_REFUND // Refund due to admin cancelling match
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2) // Positive for win/deposit, negative for entry/withdrawal
  description   String?
  matchId       String?         // Optional link to a match
  createdAt     DateTime        @default(now())

  user          User            @relation(fields: [userId], references: [id])
  match         Match?          @relation(fields: [matchId], references: [id])

  @@index([userId])
  @@index([matchId])
  @@index([type])
}
